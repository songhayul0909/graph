import datetime

import pandas as pd
import plotly.express as px
import requests
import streamlit as st

st.set_page_config(page_title="영화 가설 검증", layout="wide")

st.title("🔍 영화 가설 검증")
st.caption(
    "KOBIS(영화관입장권통합전산망) 일별 박스오피스 API로, 같은 월·일을 여러 해에 걸쳐 "
    "불러와 비교해 봅니다."
)

KOBIS_URL = "http://www.kobis.or.kr/kobisopenapi/webservice/rest/boxoffice/searchDailyBoxOfficeList.json"
GENRE_URL = "https://raw.githubusercontent.com/greatsong/modudata/main/data/kobis_genres.csv"

# 인증키: 비밀 금고(secrets)에 저장된 KOBIS_KEY 사용
KOBIS_KEY = st.secrets.get("KOBIS_KEY")

if not KOBIS_KEY:
    st.error(
        "KOBIS_KEY가 설정되어 있지 않습니다. `.streamlit/secrets.toml`에 "
        "`KOBIS_KEY = \"발급받은 키\"` 형태로 등록해 주세요."
    )
    st.stop()

today = datetime.date.today()

# ---------------------------------------------------------
# 조회 조건 입력
# ---------------------------------------------------------
st.subheader("조회할 날짜 선택")

start_year, end_year = st.slider(
    "연도 범위",
    min_value=2004,
    max_value=today.year,
    value=(today.year - 5, today.year - 1),
)

col1, col2 = st.columns(2)
with col1:
    month = st.number_input("월", min_value=1, max_value=12, value=today.month, step=1)
with col2:
    day = st.number_input("일", min_value=1, max_value=31, value=1, step=1)


@st.cache_data(show_spinner=False)
def fetch_boxoffice_range(start_year: int, end_year: int, month: int, day: int, api_key: str):
    """연도 범위 안의 같은 월/일에 대해 KOBIS 일별 박스오피스를 모두 불러와 하나로 쌓는다.
    같은 조건으로 다시 호출되면 스트림릿 캐시가 저장된 결과를 그대로 돌려준다.
    목록이 없는 해는 멈추지 않고 건너뛴다.
    """
    rows = []
    skipped_years = []

    for year in range(start_year, end_year + 1):
        # 존재하지 않는 날짜(예: 2월 29일이 없는 해)는 건너뜀
        try:
            target_date = datetime.date(year, month, day)
        except ValueError:
            skipped_years.append(year)
            continue

        target_dt = target_date.strftime("%Y%m%d")
        params = {"key": api_key, "targetDt": target_dt}

        try:
            response = requests.get(KOBIS_URL, params=params, timeout=10)
            response.raise_for_status()
            data = response.json()
        except (requests.RequestException, ValueError):
            skipped_years.append(year)
            continue

        if "faultInfo" in data:
            skipped_years.append(year)
            continue

        box_office_list = data.get("boxOfficeResult", {}).get("dailyBoxOfficeList", [])

        if not box_office_list:
            skipped_years.append(year)
            continue

        for item in box_office_list:
            item["조회연도"] = year
        rows.extend(box_office_list)

    df = pd.DataFrame(rows)
    return df, skipped_years


@st.cache_data(show_spinner=False)
def load_genre_table():
    genre_df = pd.read_csv(GENRE_URL)
    genre_df["영화코드"] = genre_df["영화코드"].astype(str)
    return genre_df


if st.button("박스오피스 조회"):
    with st.spinner(f"{start_year}년 ~ {end_year}년 {month}월 {day}일 박스오피스를 불러오는 중..."):
        df, skipped_years = fetch_boxoffice_range(start_year, end_year, month, day, KOBIS_KEY)

    if skipped_years:
        st.info(f"목록이 없어 건너뛴 연도: {', '.join(str(y) for y in skipped_years)}")

    if df.empty:
        st.warning("조회된 박스오피스 데이터가 없습니다.")
        st.stop()

    # 관객수 등 숫자 열은 문자열로 내려오므로 숫자형으로 변환
    numeric_cols = [
        "rank",
        "audiCnt",
        "audiAcc",
        "scrnCnt",
        "showCnt",
        "salesAmt",
        "salesAcc",
    ]
    for col in numeric_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    df["movieCd"] = df["movieCd"].astype(str)

    # ---------------------------------------------------------
    # 장르 붙이기: 영화코드 기준으로 장르표(kobis_genres.csv)와 병합
    # ---------------------------------------------------------
    genre_df = load_genre_table()
    genre_lookup = genre_df[["영화코드", "장르"]].rename(
        columns={"영화코드": "movieCd", "장르": "genre"}
    )

    df = df.merge(genre_lookup, on="movieCd", how="left")
    df["genre"] = df["genre"].fillna("미상")
    df.loc[df["genre"].astype(str).str.strip() == "", "genre"] = "미상"

    # ---------------------------------------------------------
    # 표로 보여주기
    # ---------------------------------------------------------
    display_df = df.rename(
        columns={
            "조회연도": "연도",
            "rank": "순위",
            "movieNm": "영화명",
            "openDt": "개봉일",
            "genre": "장르",
            "audiCnt": "당일 관객수",
            "audiAcc": "누적 관객수",
            "scrnCnt": "스크린수",
            "showCnt": "상영횟수",
            "salesAmt": "당일 매출액",
            "salesAcc": "누적 매출액",
        }
    )

    display_cols = [
        c
        for c in [
            "연도",
            "순위",
            "영화명",
            "장르",
            "개봉일",
            "당일 관객수",
            "누적 관객수",
            "스크린수",
            "상영횟수",
            "당일 매출액",
            "누적 매출액",
        ]
        if c in display_df.columns
    ]

    st.subheader(f"{start_year}년 ~ {end_year}년, 매년 {month}월 {day}일 박스오피스 10위권")
    st.dataframe(display_df[display_cols], use_container_width=True, hide_index=True)

    st.divider()

    # ---------------------------------------------------------
    # 장르 펼치기: 한 영화에 장르가 여러 개면 낱개로 나눔
    # ---------------------------------------------------------
    df_exp = df.assign(genre_single=df["genre"].astype(str).str.split(",")).explode(
        "genre_single"
    )
    df_exp["genre_single"] = df_exp["genre_single"].str.strip()

    audience_by_genre = (
        df_exp.groupby("genre_single")["audiAcc"].sum().sort_values(ascending=False)
    )
    audience_pct = (audience_by_genre / audience_by_genre.sum() * 100).round(1)

    count_by_genre = (
        df_exp.groupby("genre_single")["movieCd"].nunique().sort_values(ascending=False)
    )

    st.subheader("장르별 흥행 비교")

    left_col, right_col = st.columns(2)

    with left_col:
        st.markdown("**장르별 관객 합계**")
        audience_chart_df = pd.DataFrame(
            {
                "장르": audience_by_genre.index,
                "관객 합계": audience_by_genre.values,
                "비율(%)": audience_pct.reindex(audience_by_genre.index).values,
            }
        )

        fig_audience = px.bar(
            audience_chart_df,
            x="관객 합계",
            y="장르",
            orientation="h",
            text=audience_chart_df["비율(%)"].map(lambda v: f"{v:.1f}%"),
        )
        fig_audience.update_traces(
            hovertemplate="장르: %{y}<br>관객 합계: %{x:,}명<br>비율: %{text}<extra></extra>",
            textposition="outside",
        )
        fig_audience.update_layout(
            yaxis=dict(categoryorder="total ascending"),
            margin=dict(t=20, b=20, l=0, r=0),
        )
        st.plotly_chart(fig_audience, use_container_width=True)

    with right_col:
        st.markdown("**장르별 10위권 진입 편수**")
        count_chart_df = pd.DataFrame(
            {"장르": count_by_genre.index, "편수": count_by_genre.values}
        )

        fig_count = px.bar(
            count_chart_df,
            x="편수",
            y="장르",
            orientation="h",
        )
        fig_count.update_traces(
            hovertemplate="장르: %{y}<br>편수: %{x}편<extra></extra>",
        )
        fig_count.update_layout(
            yaxis=dict(categoryorder="total ascending"),
            margin=dict(t=20, b=20, l=0, r=0),
        )
        st.plotly_chart(fig_count, use_container_width=True)

    st.divider()

    # ---------------------------------------------------------
    # 장르를 골라 관객 비율 확인
    # ---------------------------------------------------------
    st.subheader("장르를 골라 관객 비율 확인하기")

    selected_genres = st.multiselect(
        "관객 비율을 확인할 장르를 골라 주세요",
        options=list(audience_by_genre.index),
    )

    if selected_genres:
        selected_sum = audience_by_genre.loc[selected_genres].sum()
        total_sum = audience_by_genre.sum()
        selected_pct = selected_sum / total_sum * 100 if total_sum else 0

        st.metric(
            label=" · ".join(selected_genres) + " 합산 관객 비율",
            value=f"{selected_pct:.1f}%",
            delta=f"{selected_sum:,.0f}명 / 전체 {total_sum:,.0f}명",
        )
    else:
        st.caption("장르를 하나 이상 고르면 해당 장르들의 관객 비율을 보여줍니다.")
